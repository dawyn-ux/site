---
/**
 * Logo Connect Systèmes : reproduction vectorielle du logo d'origine
 * (monogramme « CS » framboise, halos bleu pâle, CONNECT noir, SYSTEMES bleu).
 *
 * - variant="lockup" (défaut) : pastille du monogramme + mots-marques empilés (en-tête)
 * - variant="full"            : composition carrée d'origine
 * - variant="mark"            : pastille seule
 */
import { LOGO } from './logo/logo-data';

interface Props {
  variant?: 'lockup' | 'full' | 'mark';
  tone?: 'light' | 'dark';
  class?: string;
  title?: string;
}
const { variant = 'lockup', tone = 'light', class: className, title = 'Connect Systèmes' } = Astro.props;

const halos = LOGO.halos;
const markInner = `
  <g class="lg-halos" fill="none">
    ${halos.map((h) => `<path d="${h.d}" stroke-width="${h.w}" stroke-linecap="${h.cap}"/>`).join('')}
    <g transform="${LOGO.rotate}">${halos.map((h) => `<path d="${h.d}" stroke-width="${h.w}" stroke-linecap="${h.cap}"/>`).join('')}</g>
  </g>
  <g class="lg-groove" fill="none" stroke-width="${LOGO.groove.width}">
    <path d="${LOGO.groove.d}"/><path d="${LOGO.groove.d}" transform="${LOGO.rotate}"/>
  </g>
  <g class="lg-cs">
    ${LOGO.cs.map((d) => `<path d="${d}"/>`).join('')}
    <g transform="${LOGO.rotate}">${LOGO.cs.map((d) => `<path d="${d}"/>`).join('')}</g>
  </g>`;
const connect = LOGO.connect.map((l) => `<path fill-rule="${l.rule}" d="${l.d}"/>`).join('');
const systemes = `<path transform="${LOGO.systemes.transform}" d="${LOGO.systemes.d}"/>`;
---

{
  variant === 'full' && (
    <svg
      class:list={['lg', 'lg--full', `lg--${tone}`, className]}
      viewBox={LOGO.viewBox.full}
      role="img"
      aria-label={title}
    >
      <rect class="lg-bg" width="756" height="770" rx="36" />
      <Fragment set:html={markInner} />
      <g class="lg-connect" set:html={connect} />
      <g class="lg-systemes" set:html={systemes} />
    </svg>
  )
}
{
  variant !== 'full' && (
    <span class:list={['lg', `lg--${variant}`, `lg--${tone}`, className]} role="img" aria-label={title}>
      <svg class="lg-badge" viewBox={LOGO.viewBox.mark} aria-hidden="true" focusable="false">
        <rect class="lg-bg" x="48" y="67" width="650" height="650" rx="150" />
        <Fragment set:html={markInner} />
      </svg>
      {variant === 'lockup' && (
        <span class="lg-words" aria-hidden="true">
          <svg class="lg-connect" viewBox={LOGO.viewBox.connect} set:html={connect} />
          <svg class="lg-systemes" viewBox={LOGO.viewBox.systemes} set:html={systemes} />
        </span>
      )}
    </span>
  )
}

<style>
  .lg {
    --lg-red: #d3014e;
    --lg-blue: #4680bf;
    --lg-sky: #c1dcf2;
    --lg-mist: #e1ecf9;
    --lg-black: #0a0b0f;
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    line-height: 0;
  }
  .lg--dark {
    --lg-black: #f2f6fb;
    --lg-blue: #8db6e6;
  }
  .lg :global(.lg-bg) {
    fill: var(--lg-sky);
  }
  .lg :global(.lg-halos) {
    stroke: var(--lg-mist);
    transform-origin: 373px 392px;
    transform-box: view-box;
    transition: transform 1.2s var(--ease, ease);
  }
  .lg :global(.lg-groove) {
    stroke: var(--lg-mist);
  }
  .lg :global(.lg-cs) {
    fill: var(--lg-red);
  }
  .lg-connect,
  .lg :global(.lg-connect) {
    fill: var(--lg-black);
  }
  .lg-systemes,
  .lg :global(.lg-systemes) {
    fill: var(--lg-blue);
  }
  .lg-badge {
    width: 3.1rem;
    height: 3.1rem;
    flex: none;
    overflow: visible;
  }
  .lg-words {
    display: grid;
    gap: 0.32rem;
  }
  .lg-words svg {
    height: 1.02rem;
    width: auto;
    overflow: visible;
  }
  .lg-words .lg-systemes {
    margin-left: -0.1rem;
  }
  .lg--full {
    width: 100%;
    height: auto;
  }
  :global(a:hover) > .lg :global(.lg-halos),
  .lg:hover :global(.lg-halos) {
    transform: rotate(-10deg);
  }
  @media (prefers-reduced-motion: reduce) {
    .lg :global(.lg-halos) {
      transition: none;
    }
  }
</style>
