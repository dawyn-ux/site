---
import Icon from '../Icon.astro';
import GammeArt from '../GammeArt.astro';
import Halos from '../Halos.astro';
import { pages, settings, phoneHref } from '../../lib/content';

const { hero, scene_section } = pages.accueil;
const words = hero.title.split(/\s+/);

const hotspots = [
  { key: 'connector', label: 'Boîtier connecteur', href: '/gammes/connectique/' },
  { key: 'contact', label: 'Contact serti', href: '/gammes/outillage-sertissage/' },
  { key: 'marker', label: 'Repérage', href: '/gammes/accessoires-faisceaux/' },
  { key: 'sleeve', label: 'Gaine thermorétractable', href: '/gammes/gaines-thermoretractables/' },
  { key: 'braid', label: 'Tresse métallique', href: '/gammes/tresses-metalliques/' },
];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__grid-bg" aria-hidden="true"></div>
  <Halos class="hero__halos" />
  <div class="container hero__inner">
    <div class="hero__copy">
      <p class="hero__eyebrow eyebrow">{hero.eyebrow}</p>
      <h1 id="hero-title" class="display hero__title">
        {
          words.map((w, i) => (
            <>
              <span class="word" style={`--i:${i}`}>
                <span>{w}</span>
              </span>{' '}
            </>
          ))
        }
        {
          hero.highlight && (
            <span class="word word--accent" style={`--i:${words.length}`}>
              <span>{hero.highlight}</span>
            </span>
          )
        }
      </h1>
      <p class="lead hero__lead">{hero.text}</p>
      <div class="hero__actions">
        <a href={hero.primary_cta.url} class="btn" data-magnetic>
          {hero.primary_cta.label}
          <Icon name="arrow-right" size={18} />
        </a>
        <a href={hero.secondary_cta.url} class="btn btn--ghost">{hero.secondary_cta.label}</a>
      </div>
      <dl class="hero__meta">
        <div>
          <dt class="mono">Depuis</dt>
          <dd>{settings.legal.founded}</dd>
        </div>
        <div>
          <dt class="mono">Basés à</dt>
          <dd>{settings.contact.city}</dd>
        </div>
        <div>
          <dt class="mono">Téléphone</dt>
          <dd><a href={phoneHref(settings.contact.phone)}>{settings.contact.phone}</a></dd>
        </div>
      </dl>
    </div>

    <div class="hero__visual" data-scene>
      <div class="hero__fallback" aria-hidden="true">
        <GammeArt name="connecteur" />
      </div>
      <canvas class="hero__canvas" aria-hidden="true"></canvas>
      <div class="hotspots" aria-label="Anatomie d'une connexion">
        {
          hotspots.map((h) => (
            <a class="hotspot is-hidden" href={h.href} data-hotspot={h.key}>
              <span class="hotspot__dot" aria-hidden="true" />
              <span class="hotspot__label">{h.label}</span>
            </a>
          ))
        }
      </div>
      <div class="hero__caption">
        <p class="mono hero__caption-title">{scene_section.eyebrow}</p>
        <p class="hero__caption-text">{scene_section.text}</p>
      </div>
      <p class="hero__hint mono" aria-hidden="true"><Icon name="hand" size={16} /> Glissez pour faire pivoter</p>
    </div>
  </div>
</section>

<script>
  const container = document.querySelector<HTMLElement>('[data-scene]');

  const hasWebGL = () => {
    try {
      const c = document.createElement('canvas');
      return !!(window.WebGL2RenderingContext && c.getContext('webgl2'));
    } catch {
      return false;
    }
  };

  async function boot() {
    if (!container || !hasWebGL()) return;
    const canvas = container.querySelector('canvas')!;
    const hotspots = new Map<string, HTMLElement>();
    container.querySelectorAll<HTMLElement>('[data-hotspot]').forEach((el) => hotspots.set(el.dataset.hotspot!, el));
    const css = getComputedStyle(document.documentElement);
    const { initHarnessScene } = await import('../../scripts/harness-scene');
    initHarnessScene({
      canvas,
      container,
      hotspots: hotspots as Map<never, HTMLElement>,
      accent: css.getPropertyValue('--accent').trim() || '#d3014e',
      secondary: css.getPropertyValue('--accent-2').trim() || '#4680bf',
      ink: css.getPropertyValue('--ink').trim() || '#0b1220',
      reducedMotion: window.matchMedia('(prefers-reduced-motion: reduce)').matches,
      onReady: () => container.classList.add('is-ready'),
    });
  }

  if (container) {
    const start = () => {
      const io = new IntersectionObserver(
        ([entry]) => {
          if (entry.isIntersecting) {
            io.disconnect();
            boot().catch(() => container.classList.remove('is-ready'));
          }
        },
        { rootMargin: '200px' },
      );
      io.observe(container);
    };
    if ('requestIdleCallback' in window) requestIdleCallback(start, { timeout: 1200 });
    else setTimeout(start, 300);
  }
</script>

<style>
  .hero {
    position: relative;
    background:
      radial-gradient(90% 70% at 72% 38%, color-mix(in oklab, var(--mist), #fff 30%) 0%, transparent 60%),
      linear-gradient(180deg, color-mix(in oklab, var(--sky), #fff 25%) 0%, var(--paper) 100%);
    min-height: min(100dvh, 980px);
    padding-top: calc(var(--header-h) + clamp(1.5rem, 4vw, 3rem));
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
    overflow: hidden;
    display: flex;
    align-items: center;
  }
  .hero__grid-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, color-mix(in oklab, var(--accent-2), transparent 88%) 1px, transparent 1px),
      linear-gradient(to bottom, color-mix(in oklab, var(--accent-2), transparent 88%) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(ellipse 70% 60% at 70% 45%, #000 20%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 70% 60% at 70% 45%, #000 20%, transparent 75%);
    pointer-events: none;
  }
  .hero :global(.hero__halos) {
    width: min(78vw, 60rem);
    right: -14vw;
    top: 50%;
    transform: translateY(-46%);
    opacity: 0.75;
  }
  .hero__inner {
    position: relative;
    display: grid;
    gap: 2rem;
    align-items: center;
  }
  .hero__copy {
    position: relative;
    z-index: 2;
    max-width: 40rem;
  }
  .hero__eyebrow {
    animation: fade-up 0.9s var(--ease) both;
  }
  .hero__title {
    margin-top: 1.5rem;
  }
  .word {
    display: inline-block;
    overflow: hidden;
    padding-bottom: 0.08em;
    margin-bottom: -0.08em;
    vertical-align: top;
  }
  .word > span {
    display: inline-block;
    animation: word-in 1.1s var(--ease) both;
    animation-delay: calc(120ms + var(--i) * 70ms);
  }
  .word--accent {
    color: var(--accent);
  }
  .hero__lead {
    margin-top: 1.75rem;
    animation: fade-up 1s var(--ease) 0.45s both;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
    animation: fade-up 1s var(--ease) 0.55s both;
  }
  .hero__meta {
    display: grid;
    grid-template-columns: repeat(3, auto);
    justify-content: start;
    gap: 0 2.25rem;
    margin: 3rem 0 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    animation: fade-up 1s var(--ease) 0.65s both;
  }
  .hero__meta dt {
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .hero__meta dd {
    margin: 0.3rem 0 0;
    font-weight: 550;
    font-size: 1.05rem;
  }
  .hero__meta a {
    text-decoration: none;
  }

  /* ---- Visuel 3D ---- */
  .hero__visual {
    position: relative;
    height: clamp(22rem, 62vw, 34rem);
    margin-inline: calc(var(--gutter) * -1);
    touch-action: pan-y;
  }
  .hero__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    mask-image: linear-gradient(to right, transparent 0, #000 16%, #000 94%, transparent 100%),
      linear-gradient(to bottom, transparent 0, #000 8%, #000 86%, transparent 100%);
    mask-composite: intersect;
    -webkit-mask-image: linear-gradient(to right, transparent 0, #000 16%, #000 94%, transparent 100%),
      linear-gradient(to bottom, transparent 0, #000 8%, #000 86%, transparent 100%);
    -webkit-mask-composite: source-in;
    opacity: 0;
    transition: opacity 1.2s var(--ease);
    cursor: grab;
  }
  .is-dragging .hero__canvas {
    cursor: grabbing;
  }
  .hero__fallback {
    position: absolute;
    inset: 12% 10%;
    display: grid;
    place-items: center;
    transition:
      opacity 0.8s var(--ease),
      transform 1s var(--ease);
  }
  .hero__visual.is-ready .hero__canvas {
    opacity: 1;
  }
  .hero__visual.is-ready .hero__fallback {
    opacity: 0;
    transform: scale(0.96);
  }

  .hotspots {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.8s var(--ease) 0.4s;
  }
  .is-ready .hotspots {
    opacity: 1;
  }
  .hotspot {
    position: absolute;
    top: 0;
    left: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: -0.5rem 0 0 -0.5rem;
    text-decoration: none;
    pointer-events: auto;
    will-change: transform;
    transition: opacity 0.3s var(--ease);
  }
  .hotspot.is-hidden {
    opacity: 0;
    pointer-events: none;
  }
  .hotspot__dot {
    position: relative;
    width: 1rem;
    height: 1rem;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px color-mix(in oklab, var(--accent), transparent 75%);
  }
  .hotspot__dot::after {
    content: '';
    position: absolute;
    inset: -6px;
    border-radius: 50%;
    border: 1px solid var(--accent);
    animation: ping 2.4s var(--ease) infinite;
  }
  .hotspot__label {
    padding: 0.35rem 0.7rem;
    border-radius: 999px;
    border: 1px solid color-mix(in oklab, var(--ink), transparent 88%);
    background: color-mix(in oklab, var(--surface), transparent 12%);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.7);
    font-size: 0.78rem;
    font-weight: 550;
    white-space: nowrap;
    opacity: 0;
    transform: translateX(-6px);
    transition:
      opacity 0.35s var(--ease),
      transform 0.45s var(--ease),
      background-color 0.3s var(--ease),
      color 0.3s var(--ease);
  }
  @media (min-width: 1024px) and (hover: hover) {
    .hotspot__label {
      opacity: 1;
      transform: none;
    }
  }
  .hotspot.is-active .hotspot__label,
  .hotspot:focus-visible .hotspot__label {
    opacity: 1;
    transform: none;
    background: var(--ink);
    color: var(--on-ink);
  }
  .has-active .hotspot:not(.is-active) {
    opacity: 0.45;
  }

  .hero__caption {
    position: absolute;
    left: var(--gutter);
    bottom: 0.5rem;
    max-width: 19rem;
    padding: 0.9rem 1rem;
    border: 1px solid var(--line);
    border-radius: 1rem;
    background: color-mix(in oklab, var(--surface), transparent 20%);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.7);
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 0.8s var(--ease) 0.6s,
      transform 0.8s var(--ease) 0.6s;
  }
  .is-ready .hero__caption {
    opacity: 1;
    transform: none;
  }
  .hero__caption-title {
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent-2-strong);
  }
  .hero__caption-text {
    margin-top: 0.35rem;
    font-size: 0.85rem;
    line-height: 1.45;
    color: var(--muted);
  }
  .hero__hint {
    position: absolute;
    right: var(--gutter);
    top: 0.5rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    opacity: 0;
    transition: opacity 0.8s var(--ease) 0.8s;
  }
  .is-ready .hero__hint {
    opacity: 1;
  }

  @media (min-width: 1024px) {
    .hero__inner {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 0;
    }
    .hero__visual {
      height: min(78dvh, 44rem);
      margin-inline: -8rem calc((100vw - min(100vw, var(--container))) / -2 - var(--gutter));
    }
    .hero__caption {
      left: 9rem;
      bottom: 1rem;
    }
    .hero__hint {
      top: 1rem;
      right: calc(var(--gutter) + 1rem);
    }
  }
  @media (max-width: 560px) {
    .hero__meta {
      grid-template-columns: 1fr 1fr;
      gap: 1rem 1.5rem;
    }
    .hero__caption {
      display: none;
    }
  }

  @keyframes word-in {
    from {
      transform: translateY(105%);
    }
  }
  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }
  @keyframes ping {
    0% {
      transform: scale(0.6);
      opacity: 0.9;
    }
    80%,
    100% {
      transform: scale(1.8);
      opacity: 0;
    }
  }
</style>
