---
import { settings } from '../lib/content';

export interface Breadcrumb {
  name: string;
  url: string;
}

export interface SeoProps {
  /** Titre de la page (le nom du site est ajouté automatiquement). */
  title: string;
  /** Titre SEO complet saisi dans le CMS (prioritaire, sans suffixe ajouté). */
  seoTitle?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  breadcrumbs?: Breadcrumb[];
  jsonLd?: Record<string, unknown>[];
}

const {
  title,
  seoTitle,
  description = settings.description,
  image,
  noindex = false,
  type = 'website',
  publishedTime,
  modifiedTime,
  breadcrumbs = [],
  jsonLd = [],
} = Astro.props as SeoProps;

const site = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname, site).href;
const withBrand = (t: string) =>
  t.includes(settings.site_name) || `${t} | ${settings.site_name}`.length > 65 ? t : `${t} | ${settings.site_name}`;
// Le nom du site est ajouté au titre quand la longueur le permet (Google affiche ~60 caractères)
const fullTitle = seoTitle ? withBrand(seoTitle) : title === settings.site_name ? title : `${title} | ${settings.site_name}`;
const ogImage = new URL(image || settings.seo.default_image, site).href;
const orgId = new URL('/#organisation', site).href;

const organisation = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': orgId,
  name: settings.legal_name,
  alternateName: settings.site_name,
  description: settings.description,
  url: new URL('/', site).href,
  logo: new URL('/logo-512.png', site).href,
  image: new URL(settings.seo.default_image, site).href,
  telephone: settings.contact.phone,
  ...(settings.contact.fax ? { faxNumber: settings.contact.fax } : {}),
  email: settings.contact.email,
  foundingDate: String(settings.legal.founded),
  address: {
    '@type': 'PostalAddress',
    streetAddress: settings.contact.street,
    postalCode: settings.contact.postal_code,
    addressLocality: settings.contact.city,
    addressRegion: settings.contact.region,
    addressCountry: 'FR',
  },
  areaServed: 'FR',
  brand: settings.partners.map((p) => ({ '@type': 'Brand', name: p.name })),
  sameAs: Object.values(settings.social).filter(Boolean),
};

const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: settings.site_name,
  url: new URL('/', site).href,
  inLanguage: 'fr-FR',
  publisher: { '@id': orgId },
};

const breadcrumbLd =
  breadcrumbs.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [{ name: 'Accueil', url: '/' }, ...breadcrumbs].map((b, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: b.name,
          item: new URL(b.url, site).href,
        })),
      }
    : null;

const isHome = Astro.url.pathname === '/';
const graph = [organisation, ...(isHome ? [website] : []), ...(breadcrumbLd ? [breadcrumbLd] : []), ...jsonLd];
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />

<meta property="og:type" content={type} />
<meta property="og:locale" content="fr_FR" />
<meta property="og:site_name" content={settings.site_name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:alt" content={`${settings.site_name} — ${settings.tagline}`} />
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
{settings.seo.google_site_verification && <meta name="google-site-verification" content={settings.seo.google_site_verification} />}

{graph.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
