---
import arrowRight from '@phosphor-icons/core/assets/light/arrow-right-light.svg?raw';
import arrowUpRight from '@phosphor-icons/core/assets/light/arrow-up-right-light.svg?raw';
import arrowDown from '@phosphor-icons/core/assets/light/arrow-down-light.svg?raw';
import arrowLeft from '@phosphor-icons/core/assets/light/arrow-left-light.svg?raw';
import phone from '@phosphor-icons/core/assets/light/phone-light.svg?raw';
import envelope from '@phosphor-icons/core/assets/light/envelope-simple-light.svg?raw';
import mapPin from '@phosphor-icons/core/assets/light/map-pin-light.svg?raw';
import printer from '@phosphor-icons/core/assets/light/printer-light.svg?raw';
import list from '@phosphor-icons/core/assets/light/list-light.svg?raw';
import close from '@phosphor-icons/core/assets/light/x-light.svg?raw';
import download from '@phosphor-icons/core/assets/light/download-simple-light.svg?raw';
import filePdf from '@phosphor-icons/core/assets/light/file-pdf-light.svg?raw';
import fileText from '@phosphor-icons/core/assets/light/file-text-light.svg?raw';
import microscope from '@phosphor-icons/core/assets/light/microscope-light.svg?raw';
import wrench from '@phosphor-icons/core/assets/light/wrench-light.svg?raw';
import compass from '@phosphor-icons/core/assets/light/compass-light.svg?raw';
import box from '@phosphor-icons/core/assets/light/package-light.svg?raw';
import appliance from '@phosphor-icons/core/assets/light/washing-machine-light.svg?raw';
import flame from '@phosphor-icons/core/assets/light/flame-light.svg?raw';
import car from '@phosphor-icons/core/assets/light/car-profile-light.svg?raw';
import factory from '@phosphor-icons/core/assets/light/factory-light.svg?raw';
import chip from '@phosphor-icons/core/assets/light/cpu-light.svg?raw';
import screen from '@phosphor-icons/core/assets/light/television-light.svg?raw';
import check from '@phosphor-icons/core/assets/light/check-light.svg?raw';
import lightning from '@phosphor-icons/core/assets/light/lightning-light.svg?raw';
import hand from '@phosphor-icons/core/assets/light/hand-grabbing-light.svg?raw';
import clock from '@phosphor-icons/core/assets/light/clock-light.svg?raw';
import warning from '@phosphor-icons/core/assets/light/warning-light.svg?raw';
import linkedin from '@phosphor-icons/core/assets/light/linkedin-logo-light.svg?raw';
import facebook from '@phosphor-icons/core/assets/light/facebook-logo-light.svg?raw';
import youtube from '@phosphor-icons/core/assets/light/youtube-logo-light.svg?raw';

const icons = {
  'arrow-right': arrowRight,
  'arrow-up-right': arrowUpRight,
  'arrow-down': arrowDown,
  'arrow-left': arrowLeft,
  phone,
  envelope,
  'map-pin': mapPin,
  printer,
  list,
  close,
  download,
  'file-pdf': filePdf,
  'file-text': fileText,
  microscope,
  tool: wrench,
  compass,
  box,
  appliance,
  flame,
  car,
  factory,
  chip,
  screen,
  check,
  lightning,
  hand,
  clock,
  warning,
  linkedin,
  facebook,
  youtube,
} as const;

export type IconName = keyof typeof icons;

interface Props {
  name: IconName | string;
  size?: number;
  class?: string;
  label?: string;
}

const { name, size = 20, class: className, label } = Astro.props;
const raw = (icons as Record<string, string>)[name] ?? icons.lightning;
const svg = raw.replace(
  '<svg ',
  `<svg width="${size}" height="${size}" ${label ? `role="img" aria-label="${label}"` : 'aria-hidden="true" focusable="false"'} class="icon ${className ?? ''}" `,
);
---

<Fragment set:html={svg} />
