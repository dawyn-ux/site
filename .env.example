# URL publique du site (balises canonical, sitemap, Open Graph)
SITE_URL=https://www.connect-systemes.fr

# Connexion à l'administration (/admin) — GitHub OAuth App
# Callback URL à déclarer dans GitHub : https://<votre-domaine>/api/callback
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# Optionnel : forcer le dépôt / la branche édités par le CMS (détectés automatiquement sur Vercel)
# CMS_GITHUB_REPO=organisation/depot
# CMS_GITHUB_BRANCH=main

# Formulaire de contact — envoi des e-mails via Resend (https://resend.com, offre gratuite)
# Sans ces variables, le formulaire ouvre la messagerie du visiteur (mailto).
RESEND_API_KEY=
CONTACT_TO_EMAIL=commercial@connect-systemes.fr
# Expéditeur (domaine à vérifier dans Resend), ex. : Site Connect Systèmes <site@connect-systemes.fr>
CONTACT_FROM_EMAIL=
